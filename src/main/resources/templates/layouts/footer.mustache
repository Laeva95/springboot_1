<!-- 1. site info 영역 : 홈페이지 최하단에 공통으로 출력되는 사이트 정보 영역입니다. -->
<div class="mb-5 container-fluid">
    <!-- 2. hr 태그 : 구분선을 그어주는 태그입니다. -->
    <hr>
    <p>CloudStudying | <a href="#">Privacy</a> |  <a href="#">Terms</a> </p>
</div>

<!-- 3. Optional JavaScript : 부트스트랩의 동적 기능(드롭다운, 토글 등)을 동작시키려면
     자바스크립트 파일이 반드시 필요합니다. 아래 두 옵션 중 하나만 선택해서 사용하면 됩니다. -->

<!-- 4. Option 1: Bootstrap Bundle with Popper
     bootstrap.bundle.min.js 파일 하나에 부트스트랩 자바스크립트 기능과
     Popper.js(드롭다운/툴팁의 위치 계산 라이브러리) 기능이 모두 합쳐져 있는 버전입니다.
     이 script 태그가 실제로 사용 중인(주석 처리되지 않은) 옵션입니다. -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>

<!-- 5. Option 2: Separate Popper and Bootstrap JS
     Popper.js와 부트스트랩 자바스크립트 파일을 각각 따로 불러오는 방식입니다.
     아래 script 태그들은 HTML 주석 안에 있어서 실제로는 실행되지 않는 비활성 코드입니다. -->
<!--
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js" integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js" integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF" crossorigin="anonymous"></script>
-->
<!-- 6. body, html 태그 닫음. header.mustache에서 열었던 <body>와 <html> 태그를
     이 footer.mustache에서 최종적으로 닫아, 하나의 완성된 HTML 문서 구조를 이룹니다. -->
</body>
</html>
