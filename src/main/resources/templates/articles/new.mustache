
<!--
    1. articles/new.mustache
       새 게시글 작성 화면입니다.
       사용자가 제목과 내용을 입력한 뒤 Submit 버튼을 누르면 /articles/create 경로로
       POST 방식 요청이 전송되어 글 생성 처리로 이어지는 것을 목표로 설계된 화면입니다.
-->

<!-- 2. 홈페이지의 공통 상단 영역(header.mustache) 코드를 이 위치에 삽입합니다. -->
{{>layouts/header}}

<!-- 3. form 태그 : 사용자가 입력한 값을 서버(톰캣)로 전송할 때 사용하는 HTML 태그입니다.
     action 속성 : 데이터를 전송할 목적지 URL을 지정합니다. 현재는 빈 문자열("")로 되어 있어
                   요청 경로가 아직 설정되지 않은 상태입니다.
     method 속성이 없으면 기본값은 GET 방식입니다. 새 글 생성처럼 서버의 데이터를 변경하는
     요청에는 보통 method="post"를 명시적으로 지정합니다. -->
<form class="container"  action="/articles/create" method="post">
    <div class="mb-3">
        <label class="form-label">제목</label>
        <input type="text" class="form-control" name="title">
    </div>
    <div class="mb-3">
        <label class="form-label">내용</label>
        <!-- 7. textarea 태그 : 여러 줄의 문자열을 입력받을 수 있는 입력창입니다.
             rows="3" 속성은 화면에 기본으로 보여줄 줄(row) 수를 지정합니다. -->
        <textarea class="form-control" rows="3" name="content"></textarea>
    </div>

    <!-- 8. button 태그, type="submit" : 이 버튼을 클릭하면 위에서 작성한 form 태그의
         action 속성에 지정된 주소로 입력값 전체가 전송(제출)됩니다. -->
    <button type="submit" class="btn btn-primary">Submit</button>

<!--   DB에서 모든 글을 조회해서 보여주는 화면을 요청하는 a태그   -->
    <a href="/articles">Back</a>
</form>
<!-- 9. 홈페이지의 공통 하단 영역(footer.mustache) 코드를 이 위치에 삽입합니다. -->
{{>layouts/footer}}
