{{>layouts/header}}

<table class="table">
    <thead>
    <tr>
        <th scope="col">Id</th>
        <th scope="col">Email</th>
        <th scope="col">Password</th>
    </tr>
    </thead>
    <tbody>
    <!--
        model.addAttribute("articleList", articleEntityList) 으로 저장한 articleList 객체를 꺼내옴
        리스트에 저장된 요소 개수만큼 반복해서 출력
     -->
    {{#memberList}}
        <tr>
            <th>{{id}}</th>
            <td><a href="/members/{{id}}">{{email}}</a></td>
            <td>{{password}}</td>
        </tr>
    {{/memberList}}
    </tbody>
</table>

<!-- 글쓰기 화면을 요청하는 a태그 -->
<a href="/members/signup">New Member</a>

{{>layouts/footer}}